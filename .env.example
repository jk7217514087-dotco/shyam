# ==================================================
# SmartBin AI — Environment Configuration
# ==================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Leave empty to automatically use turnkey zero-config in-memory database!
# Or provide local/Atlas URI: mongodb://127.0.0.1:27017/smartbin_ai
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=smartbin_ai_super_secure_jwt_secret_2026

# AI Microservice URL (FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional Cloudinary Configuration (defaults to local file storage under /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
